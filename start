#!/bin/bash
# DB-BenchMind 启动脚本

cd "$(dirname "$0")"

# 自动检测 DISPLAY
if [ -z "$DISPLAY" ]; then
    for d in :0 :1 :10.0 localhost:10.0; do
        if xdpyinfo -display "$d" &>/dev/null 2>&1; then
            export DISPLAY="$d"
            break
        fi
    done
fi

echo "DISPLAY=$DISPLAY"

# 停止已有进程
pkill -f "build/bin/db-benchmind" 2>/dev/null || true
sleep 0.5

exec ./build/bin/db-benchmind
