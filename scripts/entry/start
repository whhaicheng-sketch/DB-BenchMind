#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

if [ ! -x ./bin/db-benchmind ]; then
    echo "Missing ./bin/db-benchmind, running scripts/entry/build first..."
    ./scripts/entry/build
fi

if [ -z "${DISPLAY:-}" ]; then
    for d in :0 :1 :10.0 localhost:10.0; do
        if xdpyinfo -display "$d" &>/dev/null 2>&1; then
            export DISPLAY="$d"
            break
        fi
    done
fi

echo "DISPLAY=$DISPLAY"

pkill -f "bin/db-benchmind" 2>/dev/null || true
pkill -TERM -f 'LauncherBootstrap.*oewizard|LauncherBootstrap.*charbench|com\.dom\.benchmarking\.swingbench\.wizards\.Wizard|com\.dom\.benchmarking\.swingbench\.CharBench|(^|/)sysbench([[:space:]]|$)|(^|/)hammerdbcli([[:space:]]|$)' 2>/dev/null || true
sleep 0.5
pkill -KILL -f 'LauncherBootstrap.*oewizard|LauncherBootstrap.*charbench|com\.dom\.benchmarking\.swingbench\.wizards\.Wizard|com\.dom\.benchmarking\.swingbench\.CharBench|(^|/)sysbench([[:space:]]|$)|(^|/)hammerdbcli([[:space:]]|$)' 2>/dev/null || true

exec ./bin/db-benchmind
