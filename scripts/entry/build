#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
TMP_DIR="$(mktemp -d)"

cleanup() {
    rm -rf "$TMP_DIR"
}

trap cleanup EXIT

cd "$ROOT_DIR"

echo "Preparing isolated Wails build workspace..."
rsync -a \
    --exclude '.git' \
    --exclude 'bin' \
    --exclude 'build' \
    --exclude 'frontend/node_modules' \
    --exclude 'frontend/dist' \
    --exclude 'data' \
    --exclude 'artifacts' \
    --exclude 'logs' \
    --exclude '*.out' \
    ./ "$TMP_DIR/"

cd "$TMP_DIR"

echo "Building Wails application..."
wails build -clean -nopackage -o db-benchmind

mkdir -p "$ROOT_DIR/bin"
cp "$TMP_DIR/build/bin/db-benchmind" "$ROOT_DIR/bin/db-benchmind"

echo "Build completed: $ROOT_DIR/bin/db-benchmind"
